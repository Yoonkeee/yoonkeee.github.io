{
  "name": "yoonkeee.github.io",
  "version": "1.0.0",
  "private": true,
  "description": "김윤기 프론트엔드 개발자 포트폴리오",
  "scripts": {
    "dev": "next dev -p 4321",
    "build": "next build",
    "typecheck": "next typegen && tsc --noEmit",
    "fonts": "node scripts/subset-font.mjs",
    "predev": "npm run fonts",
    "prebuild": "npm run fonts",
    "postbuild": "rm -rf _site && mkdir _site && cp -R out _site/pf && cp -R site-root/. _site/ && cp out/404.html _site/404.html",
    "images": "bun scripts/optimize-images.ts"
  },
  "dependencies": {
    "next": "^16.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "pretendard": "^1.3.9",
    "subset-font": "^2.9.0",
    "typescript": "5.9"
  }
}
